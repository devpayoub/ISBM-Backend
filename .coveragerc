[run]
source =
    apps/accounts
    apps/alerts
    apps/machines
    apps/common
branch = True
omit =
    */migrations/*
    */management/*
    */admin.py
    */tests/*
    */__pycache__/*

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:

[html]
directory = coverage_html
